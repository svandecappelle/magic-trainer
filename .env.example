# Copy to .env (git-ignored) next to docker-compose.yml. `make app` creates .env with a random password if missing.
POSTGRES_PASSWORD=change-me

# Login with Discord (docs/accounts.md): accounts are enabled when these three are set.
# Create an application at https://discord.com/developers/applications, then in OAuth2 add the redirect
# <PUBLIC_URL>/auth/discord/callback, and copy the client id and secret here.
PUBLIC_URL=https://magic.example.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
